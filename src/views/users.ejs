<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= titulo %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <main class="container">
    <h1><%= titulo %></h1>
    <p><a href="/">← Volver al inicio</a></p>

    <table>
      <thead>
        <tr><th>ID</th><th>Nombre</th><th>Email</th><th>Rol</th></tr>
      </thead>
      <tbody>
        <% if (usuarios.length === 0) { %>
          <tr><td colspan="4">No hay usuarios. Registrá uno con POST /api/auth/register.</td></tr>
        <% } %>
        <% usuarios.forEach(function (u) { %>
          <tr>
            <td><%= u.id %></td>
            <td><%= u.nombre %></td>
            <td><%= u.email %></td>
            <td><%= u.rol %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </main>
</body>
</html>
